{
  "name": "llm-cost-management",
  "version": "0.1.0",
  "description": "AI spending-control SDK for LLM applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "ai-cost",
    "llm-cost",
    "ai-budget",
    "token-usage",
    "ai-management",
    "llm-management",
    "llm-cost-management",
    "ai-observability"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karthick-320/llm-cost-management.git"
  },
  "bugs": {
    "url": "https://github.com/karthick-320/llm-cost-management/issues"
  },
  "homepage": "https://github.com/karthick-320/llm-cost-management#readme",
  "prepublishOnly": "npm run typecheck && npm test && npm run build"
}
